# SQLite Database URL
DATABASE_URL="file:./dev.db"

# JWT Secret for Admin Authentication (32+ characters)
JWT_SECRET="replace-with-secure-random-jwt-secret-key"

# Encryption Secret for Target Site Credentials
ENCRYPTION_SECRET="replace-with-secure-encryption-secret-key"

# Default Admin Credentials (used to seed or fallback authenticate on /admin/login)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="AdminPassword123!"

# Playwright Worker Settings
PLAYWRIGHT_HEADLESS="true"
USER_DATA_BASE_DIR="./.playwright-sessions"
WORKER_INTERVAL_HOURS="24"

