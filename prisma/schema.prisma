generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  portalPassword    String    // Hashed password for portal login
  role              String    @default("user") // "user" | "admin"
  
  // Single linked XPR3T account (Added by user after login)
  xpr3tUsername     String?
  xpr3tPassword     String?   // Hashed for records
  encryptedPassword String?   // AES-256-GCM encrypted for Playwright automated login
  targetWebsiteUrl  String    @default("https://xpr3t.com/Sign-in.html")
  buttonSelector    String    @default("#btnArbitrageStart")
  status            String    @default("active") // "active" | "inactive"
  
  lastRunAt         DateTime?
  lastRunStatus     String?   // "success" | "failed" | "running"
  lastRunMessage    String?

  // XPR3T Dashboard financial summary
  totalDeposit      String?
  totalWithdraw     String?
  totalIncome       String?
  statsUpdatedAt    DateTime?
  
  // Password reset fields
  resetToken        String?
  resetTokenExpiry  DateTime?

  // Subscription / Auto-Click validity
  subscriptionExpiresAt DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  logs              RunLog[]
  payments          PaymentOrder[]
}

model PaymentOrder {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planDays       Int
  baseAmount     Float
  expectedAmount String    // Exact unique amount e.g. "1.014"
  status         String    @default("pending") // "pending" | "paid" | "expired"
  txHash         String?   @unique
  expiresAt      DateTime
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
}

model RunLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     String   // "success" | "failed"
  message    String
  durationMs Int?
  executedAt DateTime @default(now())
}
