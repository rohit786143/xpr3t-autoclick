# SQLite Database URL
DATABASE_URL="file:./dev.db"

# JWT Secret for Admin Authentication (32+ characters)
JWT_SECRET="super-secret-autoclick-jwt-key-2026-secure"

# Encryption Secret for Target Site Credentials (32 bytes / 64 hex chars or passphrase)
ENCRYPTION_SECRET="autoclick-aes-256-gcm-secret-key-2026"

# Default Admin Credentials (used to seed or fallback authenticate on /admin/login)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="AdminPassword123!"

# Playwright Worker Settings
PLAYWRIGHT_HEADLESS="false"
USER_DATA_BASE_DIR="./.playwright-sessions"
WORKER_INTERVAL_HOURS="24"

